
{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen2.5-coder:3b",
  "default_agent": "build",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "todowrite": "allow",
    "edit": "ask",
    "bash": "ask",
    "webfetch": "deny"
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder:3b": {
          "name": "Qwen2.5-Coder 3B Local",
          "limit": {
            "context": 8192,
            "output": 2048
          }
        }
      }
    }
  }
}
